<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>PANDA AGENCY | UNIZIK Awka</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #111;
      color: white;
      line-height: 1.6;
    }

    header {
      background: #000;
      padding: 20px;
      text-align: center;
      border-bottom: 3px solid #ffd400;
    }

    header h1 {
      color: #ffd400;
      font-size: 32px;
    }

    header p {
      color: white;
      margin-top: 5px;
    }

    nav {
      margin-top: 15px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 8px;
      font-size: 14px;
    }

    nav a:hover {
      color: #ffd400;
    }

    .hero {
      min-height: 500px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 20px;
      background: linear-gradient(rgba(0,0,0,.75), rgba(0,0,0,.9));
    }

    .hero h2 {
      font-size: 42px;
      color: #ffd400;
      margin-bottom: 15px;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      font-size: 18px;
    }

    .button {
      display: inline-block;
      margin-top: 25px;
      padding: 14px 25px;
      background: #ffd400;
      color: #000;
      text-decoration: none;
      font-weight: bold;
      border-radius: 8px;
    }

    .button:hover {
      background: white;
    }

    section {
      padding: 60px 20px;
      max-width: 1100px;
      margin: auto;
    }

    section h2 {
      text-align: center;
      color: #ffd400;
      margin-bottom: 30px;
      font-size: 30px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 20px;
    }

    .card {
      background: #1c1c1c;
      padding: 25px;
      border-radius: 12px;
      border: 1px solid #333;
      text-align: center;
    }

    .card h3 {
      color: #ffd400;
      margin-bottom: 10px;
    }

    .contact {
      text-align: center;
      background: #181818;
      border-top: 2px solid #ffd400;
      border-bottom: 2px solid #ffd400;
    }

    .contact p {
      margin: 10px 0;
    }

    footer {
      background: #000;
      text-align: center;
      padding: 25px 15px;
      color: #aaa;
    }

    footer strong {
      color: #ffd400;
    }
  </style>
</head>

